# 复制为 .env 后填写；本文件不含真实密钥，可安全提交。
# 真实密钥只放在 .env（已被 .gitignore 忽略），不要写进本文件。

# ---- LLM（必填）----
# OpenAI 兼容端点，例如 https://api.openai.com/v1
LLM_BASE_URL=
# API 密钥，只写在 .env
LLM_API_KEY=
# 模型名
LLM_MODEL=
# 单次请求超时（秒）
LLM_TIMEOUT_SECONDS=30
# 429/5xx/网络错误的重试次数
LLM_MAX_RETRIES=1

# ---- 白名单 ----
# 逗号分隔的发送者标识，精确匹配；留空表示拒绝全部消息
ALLOW_FROM=

# ---- 人设与降级 ----
# 留空使用内置简洁中文人设
SYSTEM_PROMPT=
# LLM 失败时是否发送兜底话术
FALLBACK_REPLY_ENABLED=true
# 兜底话术，留空使用内置默认值
FALLBACK_REPLY_TEXT=
# 非文本消息的降级话术，留空使用内置默认值
UNSUPPORTED_MEDIA_REPLY=

# ---- 记忆 ----
SHORT_MEMORY_SIZE=20
SUMMARY_TRIGGER_COUNT=10
SUMMARY_IDLE_MINUTES=10

# ---- 输入输出 ----
MAX_INPUT_CHARS=2000
MAX_OUTPUT_CHARS=2000
REPEAT_WINDOW_SECONDS=30

# ---- 联调 ----
# true 时不调用发送接口，只以日志记录拟发送内容
DRY_RUN=false

# ---- 运行目录与日志 ----
DATA_DIR=data
LOG_DIR=data/logs
LOG_LEVEL=info

# ---- iLink ----
# 官方 iLink Bot 域名；测试或灰度时可覆盖
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_BOT_TYPE=3
